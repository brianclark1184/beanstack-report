{
  "manifest_version": 3,
  "name": "Reading Log for Beanstack",
  "version": "0.1.2",
  "description": "Turn Beanstack reading history into printable PDFs with saved student, teacher, class, and reading-goal profiles.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_title": "Create a reading log"},
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; frame-src 'self' blob:;"}
}
