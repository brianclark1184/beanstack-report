{
  "manifest_version": 3,
  "name": "Reading Log for Beanstack",
  "version": "0.1.0",
  "description": "Create printable monthly reading logs with saved student, teacher, and class profiles. Private beta.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_title": "Create a reading log"},
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; frame-src 'self' blob:;"}
}
